generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum assessment_status {
  started
  paid
  in_progress
  completed
  report_generated
  failed
}

enum payment_status {
  pending
  paid
  failed
  refunded
}

enum signal_level {
  green
  yellow
  red
}

enum final_recommendation {
  proceed_small_test
  validate_first
  adjust_idea
  pause_for_now
}

enum verification_method {
  email
}

enum verification_purpose {
  history_access
  signup_verification
  password_reset
}

enum subscription_status {
  none
  active
  canceled
  past_due
}

enum credit_ledger_type {
  purchase
  welcome_bonus
  subscription_grant
  spend
  refund
  adjustment
  expire
}

enum cifra_flow {
  income
  expense
}

enum cifra_account_kind {
  cash
  bank
  savings
  other
}

enum cifra_debt_kind {
  credit_card
  loan
  vehicle
  housing
  other
}

model verification_codes {
  vc_id         String               @id @default(cuid())
  vc_identifier String
  vc_method     verification_method
  vc_purpose    verification_purpose
  vc_code       String
  vc_created_at DateTime             @default(now())
  vc_expires_at DateTime
  vc_used_at    DateTime?
  vc_attempts   Int                  @default(0)

  @@index([vc_identifier, vc_method, vc_purpose, vc_code])
  @@map("verification_codes")
}

model history_sessions {
  hses_id         String   @id @default(cuid())
  hses_email      String
  hses_token      String   @unique
  hses_created_at DateTime @default(now())
  hses_expires_at DateTime

  @@index([hses_email])
  @@map("history_sessions")
}

model assessments {
  asmt_id                  String            @id @default(cuid())
  asmt_created_at          DateTime          @default(now())
  asmt_updated_at          DateTime          @updatedAt
  asmt_status              assessment_status @default(started)
  asmt_email               String
  asmt_name                String?
  asmt_phone               String?
  asmt_country             String?
  asmt_user_id             String?
  asmt_payment_status      payment_status?
  asmt_payment_provider    String?
  asmt_payment_reference   String?
  asmt_started_at          DateTime?
  asmt_completed_at        DateTime?
  asmt_report_generated_at DateTime?
  asmt_research_enabled    Boolean           @default(true)
  asmt_credit_cost         Int?
  asmt_credits_charged_at  DateTime?

  user                 users?                @relation(fields: [asmt_user_id], references: [user_id], onDelete: SetNull)
  assessment_profile   assessment_profiles?
  personal_fit_answers personal_fit_answers?
  business_idea        business_ideas?
  financial_inputs     financial_inputs?
  market_risk_inputs   market_risk_inputs?
  assessment_score     assessment_scores?
  assessment_report    assessment_reports?
  payments             payments[]
  credit_ledger        credit_ledger[]
  feedback             feedback?

  @@index([asmt_email])
  @@index([asmt_status])
  @@index([asmt_user_id])
  @@map("assessments")
}

model assessment_profiles {
  aprf_id                          String  @id @default(cuid())
  aprf_asmt_id                     String  @unique
  aprf_current_situation           String?
  aprf_main_goal                   String?
  aprf_expected_income_timeframe   String?
  aprf_entrepreneurship_experience String?
  aprf_capital_available_range     String?
  aprf_acceptable_loss_range       String?
  aprf_hours_per_week_range        String?
  aprf_available_schedule          String?

  assessment assessments @relation(fields: [aprf_asmt_id], references: [asmt_id], onDelete: Cascade)

  @@map("assessment_profiles")
}

model personal_fit_answers {
  pfit_id                        String  @id @default(cuid())
  pfit_asmt_id                   String  @unique
  pfit_enjoyed_activities        Json?
  pfit_avoided_activities        Json?
  pfit_work_preference           String?
  pfit_sales_comfort_score       Int?
  pfit_uncertainty_comfort_score Int?
  pfit_process_comfort_score     Int?
  pfit_hiring_preference         String?

  assessment assessments @relation(fields: [pfit_asmt_id], references: [asmt_id], onDelete: Cascade)

  @@map("personal_fit_answers")
}

model business_ideas {
  bide_id                      String  @id @default(cuid())
  bide_asmt_id                 String  @unique
  bide_original_description    String?
  bide_target_customer         String?
  bide_problem_solved          String?
  bide_why_would_pay           String?
  bide_ai_summary              String?
  bide_ai_detected_assumptions Json?
  bide_user_confirmed_summary  Boolean @default(false)
  bide_target_market           Json?

  assessment assessments @relation(fields: [bide_asmt_id], references: [asmt_id], onDelete: Cascade)

  @@map("business_ideas")
}

model financial_inputs {
  finp_id                             String   @id @default(cuid())
  finp_asmt_id                        String   @unique
  finp_initial_investment             Decimal? @db.Decimal(12, 2)
  finp_products                       Json?
  finp_price_per_sale                 Decimal? @db.Decimal(12, 2)
  finp_variable_cost_per_sale         Decimal? @db.Decimal(12, 2)
  finp_estimated_monthly_sales        Int?
  finp_fixed_monthly_costs_range      String?
  finp_fixed_monthly_costs_amount     Decimal? @db.Decimal(12, 2)
  finp_currency                       String?  @default("USD")
  finp_gross_margin_per_sale          Decimal? @db.Decimal(12, 2)
  finp_gross_margin_percentage        Decimal? @db.Decimal(5, 2)
  finp_estimated_monthly_gross_profit Decimal? @db.Decimal(12, 2)
  finp_estimated_monthly_net_profit   Decimal? @db.Decimal(12, 2)
  finp_break_even_sales               Int?
  finp_payback_months                 Decimal? @db.Decimal(6, 2)

  assessment assessments @relation(fields: [finp_asmt_id], references: [asmt_id], onDelete: Cascade)

  @@map("financial_inputs")
}

model market_risk_inputs {
  mrsk_id                      String   @id @default(cuid())
  mrsk_asmt_id                 String   @unique
  mrsk_has_talked_to_customers Boolean?
  mrsk_customer_evidence_level String?
  mrsk_competition_level       String?
  mrsk_acquisition_channel     String?
  mrsk_business_dependencies   Json?
  mrsk_main_concern            String?
  mrsk_success_condition       String?

  assessment assessments @relation(fields: [mrsk_asmt_id], references: [asmt_id], onDelete: Cascade)

  @@map("market_risk_inputs")
}

model assessment_scores {
  ascs_id                          String                @id @default(cuid())
  ascs_asmt_id                     String                @unique
  ascs_personal_fit_score          Int?
  ascs_financial_viability_score   Int?
  ascs_commercial_viability_score  Int?
  ascs_risk_level_score            Int?
  ascs_time_fit_score              Int?
  ascs_scalability_score           Int?
  ascs_personal_fit_signal         signal_level?
  ascs_financial_viability_signal  signal_level?
  ascs_commercial_viability_signal signal_level?
  ascs_risk_level_signal           signal_level?
  ascs_time_fit_signal             signal_level?
  ascs_scalability_signal          signal_level?
  ascs_final_recommendation        final_recommendation?
  ascs_red_flags                   Json?
  ascs_calculated_metrics          Json?
  ascs_scoring_version             String?

  assessment assessments @relation(fields: [ascs_asmt_id], references: [asmt_id], onDelete: Cascade)

  @@map("assessment_scores")
}

model assessment_reports {
  arep_id                        String   @id @default(cuid())
  arep_asmt_id                   String   @unique
  arep_executive_summary         String?
  arep_business_understanding    String?
  arep_strengths                 Json?
  arep_risks                     Json?
  arep_personal_fit_analysis     String?
  arep_financial_analysis        String?
  arep_time_operation_analysis   String?
  arep_scalability_analysis      String?
  arep_validation_plan           Json?
  arep_final_recommendation_text String?
  arep_pdf_url                   String?
  arep_ai_model_used             String?
  arep_prompt_version            String?
  arep_review                    Json?
  arep_needs_human_review        Boolean  @default(false)
  arep_research                  Json?
  arep_created_at                DateTime @default(now())

  assessment assessments @relation(fields: [arep_asmt_id], references: [asmt_id], onDelete: Cascade)

  @@map("assessment_reports")
}

model payments {
  paym_id                  String         @id @default(cuid())
  paym_asmt_id             String?
  paym_user_id             String?
  paym_provider            String
  paym_provider_session_id String?
  paym_provider_payment_id String?
  paym_amount              Decimal        @db.Decimal(12, 2)
  paym_currency            String         @default("USD")
  paym_status              payment_status @default(pending)
  paym_created_at          DateTime       @default(now())
  paym_paid_at             DateTime?
  paym_raw_payload         Json?

  assessment    assessments?    @relation(fields: [paym_asmt_id], references: [asmt_id], onDelete: Cascade)
  user          users?          @relation(fields: [paym_user_id], references: [user_id], onDelete: SetNull)
  credit_ledger credit_ledger[]

  @@unique([paym_provider, paym_provider_payment_id])
  @@index([paym_asmt_id])
  @@index([paym_user_id])
  @@index([paym_status])
  @@map("payments")
}

model credit_ledger {
  cled_id              String             @id @default(cuid())
  cled_user_id         String
  cled_type            credit_ledger_type
  cled_amount          Int
  cled_balance_after   Int
  cled_asmt_id         String?
  cled_payment_id      String?
  cled_idempotency_key String             @unique
  cled_metadata        Json?
  cled_created_at      DateTime           @default(now())

  user       users        @relation(fields: [cled_user_id], references: [user_id], onDelete: Restrict)
  assessment assessments? @relation(fields: [cled_asmt_id], references: [asmt_id], onDelete: SetNull)
  payment    payments?    @relation(fields: [cled_payment_id], references: [paym_id], onDelete: SetNull)

  @@index([cled_user_id, cled_created_at])
  @@map("credit_ledger")
}

// Cifra: finanzas personales. Importes en centavos (MXN); corte y pago son día del mes.
model cifra_accounts {
  cacc_id            String             @id @default(cuid())
  cacc_user_id       String
  cacc_name          String
  cacc_kind          cifra_account_kind
  cacc_balance_cents Int                @default(0)
  cacc_notes         String?
  cacc_created_at    DateTime           @default(now())
  cacc_updated_at    DateTime           @updatedAt

  user users @relation(fields: [cacc_user_id], references: [user_id], onDelete: Cascade)

  @@index([cacc_user_id])
  @@map("cifra_accounts")
}

// Tarjeta de crédito: solo identidad. Saldo, límite, corte y pagos viven en su deuda (cifra_debts).
model cifra_cards {
  ccard_id         String   @id @default(cuid())
  ccard_user_id    String
  ccard_name       String
  ccard_last4      String?
  ccard_created_at DateTime @default(now())
  ccard_updated_at DateTime @updatedAt

  user         users                @relation(fields: [ccard_user_id], references: [user_id], onDelete: Cascade)
  debt         cifra_debts?
  transactions cifra_transactions[]

  @@index([ccard_user_id])
  @@map("cifra_cards")
}

model cifra_debts {
  cdebt_id                 String          @id @default(cuid())
  cdebt_user_id            String
  cdebt_name               String
  cdebt_notes              String?
  cdebt_kind               cifra_debt_kind
  cdebt_balance_cents      Int
  cdebt_credit_limit_cents Int?
  cdebt_annual_rate_pct    Decimal?        @db.Decimal(5, 2)
  cdebt_next_due_on        DateTime?       @db.Date
  cdebt_due_day            Int
  cdebt_due_last_day       Boolean         @default(false)
  cdebt_next_cut_on        DateTime?       @db.Date
  cdebt_cut_day            Int?
  cdebt_cut_last_day       Boolean         @default(false)
  cdebt_next_payment_cents Int?
  cdebt_min_payment_cents  Int?
  cdebt_variable_payment   Boolean         @default(false)
  cdebt_recurring          Boolean         @default(true)
  cdebt_ends_on            DateTime?       @db.Date
  cdebt_paid_off           Boolean         @default(false)
  cdebt_card_id            String?         @unique
  cdebt_created_at         DateTime        @default(now())
  cdebt_updated_at         DateTime        @updatedAt

  user         users                @relation(fields: [cdebt_user_id], references: [user_id], onDelete: Cascade)
  card         cifra_cards?         @relation(fields: [cdebt_card_id], references: [ccard_id], onDelete: SetNull)
  transactions cifra_transactions[]

  @@index([cdebt_user_id])
  @@map("cifra_debts")
}

model cifra_fixed_expenses {
  cfix_id           String    @id @default(cuid())
  cfix_user_id      String
  cfix_name         String
  cfix_notes        String?
  cfix_category     String
  cfix_amount_cents Int?
  cfix_variable     Boolean   @default(false)
  cfix_next_due_on  DateTime? @db.Date
  cfix_due_day      Int
  cfix_due_last_day Boolean   @default(false)
  cfix_recurring    Boolean   @default(true)
  cfix_active       Boolean   @default(true)
  cfix_created_at   DateTime  @default(now())
  cfix_updated_at   DateTime  @updatedAt

  user         users                @relation(fields: [cfix_user_id], references: [user_id], onDelete: Cascade)
  transactions cifra_transactions[]

  @@index([cfix_user_id])
  @@map("cifra_fixed_expenses")
}

model cifra_transactions {
  ctrx_id                    String     @id @default(cuid())
  ctrx_user_id               String
  ctrx_flow                  cifra_flow
  ctrx_category              String
  ctrx_amount_cents          Int
  ctrx_occurred_on           DateTime   @db.Date
  ctrx_description           String?
  ctrx_debt_id               String?
  ctrx_fixed_expense_id      String?
  ctrx_period                String?
  ctrx_applied_to_debt_cents Int        @default(0)
  // Compra hecha con una tarjeta (suma a su saldo)
  ctrx_card_id               String?
  // Pago de tarjeta: transferencia, no cuenta como gasto; sus partes de gasto son filas derivadas
  ctrx_is_transfer           Boolean    @default(false)
  ctrx_payment_id            String?
  // Estado previo al pago, para poder deshacerlo al borrar el movimiento
  ctrx_prev_due_on           DateTime?  @db.Date
  ctrx_prev_cut_on           DateTime?  @db.Date
  ctrx_prev_amount_cents     Int?
  ctrx_created_at            DateTime   @default(now())

  user          users                 @relation(fields: [ctrx_user_id], references: [user_id], onDelete: Cascade)
  debt          cifra_debts?          @relation(fields: [ctrx_debt_id], references: [cdebt_id], onDelete: SetNull)
  fixed_expense cifra_fixed_expenses? @relation(fields: [ctrx_fixed_expense_id], references: [cfix_id], onDelete: SetNull)
  card          cifra_cards?          @relation(fields: [ctrx_card_id], references: [ccard_id], onDelete: SetNull)
  payment       cifra_transactions?   @relation("cifra_payment_parts", fields: [ctrx_payment_id], references: [ctrx_id], onDelete: Cascade)
  parts         cifra_transactions[]  @relation("cifra_payment_parts")

  @@unique([ctrx_debt_id, ctrx_period])
  @@unique([ctrx_fixed_expense_id, ctrx_period])
  @@index([ctrx_user_id, ctrx_occurred_on])
  @@index([ctrx_card_id])
  @@map("cifra_transactions")
}

model users {
  user_id                       String              @id @default(cuid())
  user_email                    String              @unique
  user_password_hash            String
  user_name                     String?
  user_phone                    String?
  user_email_verified_at        DateTime?
  user_cifra_ai_consent_at      DateTime?
  user_subscription_status      subscription_status @default(none)
  user_subscription_plan        String?
  user_subscription_period_end  DateTime?
  user_subscription_canceled_at DateTime?
  user_subscription_provider    String?
  user_subscription_provider_id String?
  user_stripe_customer_id       String?             @unique
  user_credits_balance          Int                 @default(0)
  user_created_at               DateTime            @default(now())
  user_updated_at               DateTime            @updatedAt

  user_sessions user_sessions[]
  assessments   assessments[]
  payments      payments[]
  credit_ledger credit_ledger[]
  suggestions   suggestions[]

  cifra_accounts       cifra_accounts[]
  cifra_cards          cifra_cards[]
  cifra_debts          cifra_debts[]
  cifra_fixed_expenses cifra_fixed_expenses[]
  cifra_transactions   cifra_transactions[]

  @@map("users")
}

model user_sessions {
  usess_id         String   @id @default(cuid())
  usess_user_id    String
  usess_token      String   @unique
  usess_created_at DateTime @default(now())
  usess_expires_at DateTime

  user users @relation(fields: [usess_user_id], references: [user_id], onDelete: Cascade)

  @@index([usess_user_id])
  @@map("user_sessions")
}

/// Sugerencias de funciones que la persona escribe desde la cuenta (beta).
model suggestions {
  sugg_id         String   @id @default(cuid())
  sugg_user_id    String?
  sugg_message    String
  /// Ruta desde la que se envió (para contexto; no se muestra a la persona).
  sugg_page       String?
  sugg_created_at DateTime @default(now())

  user users? @relation(fields: [sugg_user_id], references: [user_id], onDelete: SetNull)

  @@index([sugg_user_id, sugg_created_at])
  @@map("suggestions")
}

model feedback {
  fdbk_id                  String   @id @default(cuid())
  fdbk_asmt_id             String   @unique
  fdbk_rating              Int?
  fdbk_clarity_score       Int?
  fdbk_usefulness_score    Int?
  fdbk_comment             String?
  fdbk_would_recommend     Boolean?
  fdbk_testimonial_consent Boolean  @default(false)
  fdbk_created_at          DateTime @default(now())

  assessment assessments @relation(fields: [fdbk_asmt_id], references: [asmt_id], onDelete: Cascade)

  @@map("feedback")
}

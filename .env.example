# PostgreSQL connection string
# Local Docker: postgresql://decida:decida@localhost:5432/decida?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# OpenAI (server-side only)
OPENAI_API_KEY=""
OPENAI_MODEL_NARRATIVE=gpt-4o-mini
OPENAI_MODEL_REASONING=gpt-5-mini
OPENAI_MODEL_CAPTURE=gpt-4.1-mini
OPENAI_MODEL_TRANSCRIBE=gpt-4o-mini-transcribe
OPENAI_REASONING_EFFORT=medium
OPENAI_MODEL_RESEARCH=gpt-4.1-mini
OPENAI_MODEL_RESEARCH_OFFICIAL=gpt-4.1
OPENAI_MODEL_RESEARCH_STRUCTURE=gpt-4o-mini

# App URL for metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (transactional email — verification codes, password reset)
# Optional in development: without it, emails are logged to the server console instead of sent.
# Required in production (sendEmail throws if missing and NODE_ENV=production).
RESEND_API_KEY=""
# Remitente. Debe ser una dirección de un dominio VERIFICADO en resend.com/domains,
# con formato: Decida <hello@tu-dominio.com> (evita no-reply: Resend lo marca como mala práctica). Para pruebas sin dominio propio
# se puede usar "Decida <onboarding@resend.dev>", pero Resend solo entrega al correo
# con el que se creó la cuenta de Resend. Ver wiki/arquitectura/correo-transaccional-resend.md
RESEND_FROM_EMAIL="Decida <hello@decida.mx>"

# Sentry — monitoreo de errores. Mismo DSN en ambas: SENTRY_DSN lo usa el servidor
# y NEXT_PUBLIC_SENTRY_DSN el navegador (se incrusta al construir, así que en
# Railway debe existir ANTES del build). Sin DSN, Sentry no envía nada. Tampoco envía nada con `next dev` (NODE_ENV=development).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Solo para subir source maps durante el build (Sentry → Settings → Auth Tokens).
SENTRY_AUTH_TOKEN=""

# PostHog — analytics (apagado con `next dev`: solo cuenta producción). Both values are public browser configuration and must be
# present before the production build so Next.js can embed them in the client.
NEXT_PUBLIC_POSTHOG_KEY="your_posthog_project_token"
NEXT_PUBLIC_POSTHOG_HOST="your_posthog_host"


# Stripe — suscripción a planes mensuales con créditos.
# Sin STRIPE_SECRET_KEY el plan se activa en modo simulado
# (desarrollo local y e2e). Usa claves de modo test (sk_test_...).
STRIPE_SECRET_KEY=""
# Secreto de firma del webhook (whsec_...). En local: `stripe listen
# --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=""
# Planes mensuales (Product catalog → precio RECURRENTE mensual en MXN → price_...):
# Explora $59 (200 créditos), Valida $149 (600), Escala $399 (2000).
# Si se omiten, Checkout usa price_data en línea con los montos del código.
# Con price ids, el plan se reconoce por el id que cobra Stripe (también tras un
# cambio de plan en el portal); sin ellos, por la metadata del checkout.
STRIPE_PRICE_EXPLORA=""
STRIPE_PRICE_VALIDA=""
STRIPE_PRICE_ESCALA=""

# Remitente de los correos de cobro del plan.
# Debe ser una dirección de un dominio verificado en Resend. Los recibos de cada
# pago los manda Stripe (Dashboard -> Settings -> Customer emails).
RESEND_BILLING_FROM_EMAIL="Decida <billing@decida.mx>"

# Pasada de revisión del reporte (una llamada extra que busca contradicciones y
# conclusiones sin sustento, y reescribe solo las secciones señaladas).
# REPORT_REVIEW_ENABLED=false la apaga. Con más de REPORT_REVIEW_MAX_ISSUES
# problemas el reporte se marca «requiere revisión humana» y no se reescribe.
REPORT_REVIEW_ENABLED="true"
REPORT_REVIEW_MAX_ISSUES="6"
REPORT_REVIEW_MAX_REWRITES="4"


# Investigación de mercado del reporte: la decide cada persona en su evaluación.
# Solo ponla en false como apagado de emergencia (nadie podría usarla).
REPORT_RESEARCH_ENABLED=true
# País del mercado objetivo cuando la idea no lo indica
REPORT_DEFAULT_MARKET_COUNTRY=México

# Cloudflare Turnstile (captcha del registro). TURNSTILE_DISABLED=true lo apaga solo fuera de producción
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
TURNSTILE_DISABLED=""

# PostgreSQL connection string
# Local Docker: postgresql://decida:decida@localhost:5432/decida?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# OpenAI (server-side only)
OPENAI_API_KEY=""
OPENAI_MODEL_NARRATIVE=gpt-4o-mini
OPENAI_MODEL_REASONING=o4-mini
OPENAI_REASONING_EFFORT=medium

# App URL for metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (transactional email — verification codes, password reset)
# Optional in development: without it, emails are logged to the server console instead of sent.
# Required in production (sendEmail throws if missing and NODE_ENV=production).
RESEND_API_KEY=""
# Remitente. Debe ser una dirección de un dominio VERIFICADO en resend.com/domains,
# con formato: Decida <no-reply@mail.tu-dominio.com>. Para pruebas sin dominio propio
# se puede usar "Decida <onboarding@resend.dev>", pero Resend solo entrega al correo
# con el que se creó la cuenta de Resend. Ver wiki/arquitectura/correo-transaccional-resend.md
RESEND_FROM_EMAIL="Decida <onboarding@decida.app>"

# Sentry — monitoreo de errores. Mismo DSN en ambas: SENTRY_DSN lo usa el servidor
# y NEXT_PUBLIC_SENTRY_DSN el navegador (se incrusta al construir, así que en
# Railway debe existir ANTES del build). Sin DSN, Sentry no envía nada.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Solo para subir source maps durante el build (Sentry → Settings → Auth Tokens).
SENTRY_AUTH_TOKEN=""

# PostHog — analytics. Both values are public browser configuration and must be
# present before the production build so Next.js can embed them in the client.
NEXT_PUBLIC_POSTHOG_KEY="your_posthog_project_token"
NEXT_PUBLIC_POSTHOG_HOST="your_posthog_host"


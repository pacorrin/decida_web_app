{
  "name": "decida",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:pull": "prisma db pull",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "evals:baseline": "tsx --tsconfig evals/tsconfig.json evals/run.ts baseline",
    "evals:run": "tsx --tsconfig evals/tsconfig.json evals/run.ts",
    "evals": "tsx --tsconfig evals/tsconfig.json evals/index.ts",
    "evals:judge": "tsx --tsconfig evals/tsconfig.json evals/judge.ts",
    "evals:compare": "tsx --tsconfig evals/tsconfig.json evals/compare.ts",
    "evals:calibrate-sheet": "tsx --tsconfig evals/tsconfig.json evals/calibrate.ts sheet",
    "evals:calibrate": "tsx --tsconfig evals/tsconfig.json evals/calibrate.ts report"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@posthog/ai": "^8.13.6",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/nextjs": "^11.7.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "openai": "^6.45.0",
    "pg": "^8.22.0",
    "posthog-js": "^1.438.9",
    "posthog-node": "^5.56.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.18.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.8",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
